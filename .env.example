# Universal-SciAgent Environment Variables
# Copy this file to .env and fill in your API keys

# ===========================================
# Volcengine Ark Model Configuration (Required)
# ===========================================
# Get your API key from: https://console.volcengine.com/ark/

# Agent Model (for LLM reasoning)
MODEL_AGENT_NAME=your-endpoint-id
MODEL_AGENT_API_KEY=your-api-key
MODEL_AGENT_API_BASE=https://ark.cn-beijing.volces.com/api/v3/
MODEL_AGENT_PROVIDER=openai

# Embedding Model (for vector search)
MODEL_EMBEDDING_NAME=your-embedding-endpoint-id
MODEL_EMBEDDING_API_KEY=your-api-key
MODEL_EMBEDDING_API_BASE=https://ark.cn-beijing.volces.com/api/v3/

# ===========================================
# Optional Settings
# ===========================================

# Server port (default: 8000)
# PORT=8000

# Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Maximum papers per search
# MAX_PAPERS_PER_SEARCH=20

# Maximum cost per task (USD)
# MAX_COST_PER_TASK=2.0
